# ==============================================================================
# ReportIQ – AI Government Statistics Navigator Environment Configuration
# ==============================================================================

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
# If left empty, ReportIQ runs in deterministic offline development mode
GEMINI_API_KEY=your_gemini_api_key_here

# Active Gemini Model: gemini-3.8-flash (Recommended), gemini-3.5-flash-lite, or gemini-4-argon
GEMINI_MODEL=gemini-3.8-flash

# RAG & Retrieval Tuning
RETRIEVAL_CONFIDENCE_THRESHOLD=0.30
TOP_K_CHUNKS=6
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# File Upload Limits
MAX_UPLOAD_SIZE_MB=60
